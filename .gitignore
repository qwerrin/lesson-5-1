.venv/
__pycache__/
*.pyc
.pytest_cache/

# pytest に --basetemp で渡す一時置き場。既定の %TEMP% を使うと後片付けで
# PermissionError（共有のシンボリックリンクを消せない）が出るため、
# README ではこちらへ逃がす手を案内している＝これからも毎回できる。
.pytest_tmp/

# 資格情報。public リポジトリなので、絶対に追跡させない。
# credentials.json は OAuth クライアントのシークレット、
# token.json は自分の Google アカウントのアクセス権そのもの。
credentials.json
token.json
*credentials*.json
*client_secret*.json
token*.json

# 課題2 のサービスアカウント鍵。**上のパターンでは1つも当たらない。**
# `service-account.json` に `credentials` も `client_secret` も `token` も
# 含まれないため。「資格情報だから当然除外されているはず」で流すと素通りする
# ——パターンは意味ではなく名前でしか照合しない（2026-09-06 に実際に確認して追加）。
service-account.json
*service-account*.json
*service_account*.json

# 課題4（Zoom）の Server-to-Server OAuth の資格情報。
# Account ID / Client ID / Client Secret を環境変数で渡すため。
.env
.env.*

# ただし見本は追跡する。課題9は .env 方式なので、値の入れ方が分かる
# ファイルがリポジトリに無いと、採点者が動かせない。
# `.env.*` に巻き込まれて黙って除外されるため、明示的に戻す。
!.env.example

# mutate.py が強制終了に備えて置く控え。正常終了すれば残らない。
.mutate_backup/

# 実行時の状態。**記録（results.json）とは性質が違う。**
# 追跡すると、新しいクローンが「他人がどこまで読んだか」を持って始まり、
# まだ読んでいない範囲を飛ばす——この課題の目的（見逃しを防ぐ）に真っ向から反する。
# コミットのたびに差分が出るノイズにもなる。
task1/state.json
task2/logs/

# 課題3 の書き出し台帳。**同じ形。** 追跡すると、クローンした人の手元で
# 「もう書き出し済み」から始まり、AlreadyPosted で止まって**一度も動かせない**。
# ついでに Google ドキュメントの ID と URL が public リポジトリに載る
# ——2026-09-14、実機を1回通した直後に気づいた（除外されていなかった）。
task3/meeting/posted.json

# 課題3 の発展（決定事項を LINE に流す）の送信済み台帳。**まったく同じ理由。**
# 追跡すると、クローンした人の手元で「もう送った」から始まり、
# AlreadyNotified で止まって一度も送れない。messageId も public には要らない。
task3/meeting/notified.json

# 課題3 の音声素材と、その中間生成物。
# meeting/script.md が正本で、lines.txt はそこから抽出した TTS 入力＝派生物。
# 追跡すると「台本を直したのに lines.txt が古い」状態が git に残せてしまい、
# **正解データのほうが先に壊れる**（script.md §2 の理由と同じ）。
task3/meeting/lines.txt
task3/meeting/*.wav
task3/meeting/*.mp3
# **`*.wav` は `/` を跨がない。** 上の行は `_parts/000.wav` に1つも当たらず、
# 56ファイル・8MB が追跡対象のまま残っていた（2026-09-12 に実測）。
# この上の service-account.json の欄と同じ形——パターンは意味ではなく名前で照合する。
task3/meeting/_parts/
