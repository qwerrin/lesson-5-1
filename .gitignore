.venv/
__pycache__/
*.pyc
.pytest_cache/

# pytest に --basetemp で渡す一時置き場。既定の %TEMP% を使うと後片付けで
# PermissionError（共有のシンボリックリンクを消せない）が出るため、
# README ではこちらへ逃がす手を案内している＝これからも毎回できる。
.pytest_tmp/

# 資格情報。public リポジトリなので、絶対に追跡させない。
# credentials.json は OAuth クライアントのシークレット、
# token.json は自分の Google アカウントのアクセス権そのもの。
credentials.json
token.json
*credentials*.json
*client_secret*.json
token*.json

# 課題2 のサービスアカウント鍵。**上のパターンでは1つも当たらない。**
# `service-account.json` に `credentials` も `client_secret` も `token` も
# 含まれないため。「資格情報だから当然除外されているはず」で流すと素通りする
# ——パターンは意味ではなく名前でしか照合しない（2026-09-06 に実際に確認して追加）。
service-account.json
*service-account*.json
*service_account*.json

# 課題4（Zoom）の Server-to-Server OAuth の資格情報。
# Account ID / Client ID / Client Secret を環境変数で渡すため。
.env
.env.*

# ただし見本は追跡する。課題9は .env 方式なので、値の入れ方が分かる
# ファイルがリポジトリに無いと、採点者が動かせない。
# `.env.*` に巻き込まれて黙って除外されるため、明示的に戻す。
!.env.example

# mutate.py が強制終了に備えて置く控え。正常終了すれば残らない。
.mutate_backup/

# 実行時の状態。**記録（results.json）とは性質が違う。**
# 追跡すると、新しいクローンが「他人がどこまで読んだか」を持って始まり、
# まだ読んでいない範囲を飛ばす——この課題の目的（見逃しを防ぐ）に真っ向から反する。
# コミットのたびに差分が出るノイズにもなる。
task1/state.json
